{
  "name": "toolshare-monorepo",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@toolshare/web",
    "dev:ux": "turbo run dev --filter=@toolshare/ux",
    "dev:mobile": "turbo run dev --filter=@toolshare/mobile",
    "dev:ios": "turbo run dev --filter=@toolshare/ios",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "lockfile:check": "pnpm install --frozen-lockfile --lockfile-only",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:e2e": "playwright test",
    "test:e2e:prod": "PLAYWRIGHT_PROD=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "dockerd && supabase start",
    "db:link": "bash scripts/supabase/link-prod.sh",
    "db:pull-schema": "bash scripts/supabase/pull-schema.sh",
    "db:pull-data": "bash scripts/supabase/pull-prod-data.sh",
    "db:load-snapshot": "bash scripts/supabase/load-snapshot-local.sh",
    "db:refresh": "bash scripts/supabase/refresh-local-db.sh",
    "db:reset": "supabase db reset --local"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.3",
    "next": "^16.2.9",
    "postcss-import": "^16.1.1",
    "postcss-import-url": "^7.2.0",
    "postcss-url": "^10.1.4",
    "prettier": "^3.4.2",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "lightningcss": "^1.32.0",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "version": "0.0.2"
}
